// Prisma schema for OHé Diag

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Role {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  USER
}


enum TestStatus {
  PENDING          // Compte créé, pas encore activé par l'admin
  READY_TO_START   // Activé par l'admin, en attente que l'user commence
  IN_PROGRESS      // Test en cours
  COMPLETED        // Test terminé
  EXPIRED          // Deadline dépassée sans complétion
}


enum QuestionType {
  PROCEDURAL
  DECLARATIF
}

enum QuestionCategory {
  SINGULAR_PLURAL      // Bloc 1
  CONJUGATION          // Bloc 2
  PAST_PARTICIPLE      // Bloc 3
  SPELLING             // Bloc 4
  SYNTAX               // Bloc 5
  COMPREHENSION        // Bloc 6
  DECLARATIVE          // Bloc 7
}

enum Level {
  A
  B1
  B2
  C
}

enum DeclarativeAxis {
  ADAPTATION
  INTEREST
}

// ============ MODELS ============

model Organization {
  id                  String              @id @default(cuid())
  name                String
  credits             Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  users               User[]
  groups              Group[]           // ← NOUVEAU
  creditTransactions  CreditTransaction[]
}


model Group {
  id              String       @id @default(cuid())
  name            String
  organizationId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants    User[]       @relation("GroupParticipants")
  supervisors     User[]       @relation("GroupSupervisors")

  @@unique([organizationId, name])
  @@index([organizationId])
}


model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  passwordHash        String?
  firstName           String?
  lastName            String?
  role                Role          @default(USER)
  organizationId      String?
  groupId             String?       // ← NOUVEAU (participants)
  magicLinkToken      String?       @unique
  magicLinkExpiresAt  DateTime?
    passwordResetToken     String?       @unique
  passwordResetExpiresAt DateTime?
  passwordCreated     Boolean       @default(false)
  consentedAt         DateTime?
  consentVersion      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group               Group?        @relation("GroupParticipants", fields: [groupId], references: [id], onDelete: SetNull)  // ← NOUVEAU
  supervisedGroups    Group[]       @relation("GroupSupervisors")  // ← NOUVEAU (superviseurs)
  testSessions        TestSession[]

  @@index([passwordResetToken])
  @@index([organizationId])
  @@index([groupId])         // ← NOUVEAU
  @@index([magicLinkToken])
}


model TestSession {
  id                          String      @id @default(cuid())
  userId                      String
  status                      TestStatus  @default(PENDING)
  currentQuestionIndex        Int         @default(0)
  questionsOrder              Json
  currentQuestionServedCount  Int         @default(0)
  startedAt                   DateTime?
  completedAt                 DateTime?

  // Activation & deadline (nouveau flow)
  deadline                    DateTime?
  activatedAt                 DateTime?
  activatedBy                 String?     // ID de l'admin qui a activé
  reminderJ1SentAt            DateTime?
  expiredAt                   DateTime?

  // Scores par bloc (procédural) — 0, 0.5, 0.75 ou 1
  scoreBloc1                  Float?
  scoreBloc2                  Float?
  scoreBloc3                  Float?
  scoreBloc4                  Float?
  scoreBloc5                  Float?
  scoreBloc6                  Float?

  // Score global procédural
  scoreProcedural             Float?      // Total /6 (0 à 6)
  level                       Level?

  // Scores déclaratifs (sur 5 chacun)
  scoreAdaptation             Int?
  scoreInteret                Int?
  quadrant                    Int?        // 1 à 4

  // Legacy (gardé pour compat ascendante, sera supprimé plus tard)
  scoreDeclaratif             Int?

  creditConsumed              Boolean     @default(false)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  user                        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers                     Answer[]

  @@index([userId])
  @@index([status])
  @@index([deadline])
}


model Question {
  id                  String           @id @default(cuid())
  type                QuestionType
  category            QuestionCategory?
  subCategory         String?
  blockNumber         Int?             // 1 à 7 (pour scoring par bloc)
  questionText        String
  instruction      String?
  sourceText          String?          // Texte source pour le bloc 6 (compréhension)
  options             Json
  correctAnswerIndex  Int?
  declarativeAxis     DeclarativeAxis?
  declarativeWeight   Int?
  timeLimit           Int              @default(15)
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  answers             Answer[]

  @@index([type])
  @@index([category])
  @@index([blockNumber])
}

model Answer {
  id                    String      @id @default(cuid())
  testSessionId         String
  questionId            String
  selectedOptionIndex   Int?
  isCorrect             Boolean     @default(false)
  timeSpent             Int?
  answeredAt            DateTime    @default(now())

  testSession           TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  question              Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([testSessionId, questionId])
  @@index([testSessionId])
}

model CreditTransaction {
  id              String       @id @default(cuid())
  organizationId  String
  amount          Int
  reason          String
  createdById     String?
  createdAt       DateTime     @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ImpersonationLog {
  id              String    @id @default(cuid())
  superadminId    String
  organizationId  String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  ipAddress       String?
  userAgent       String?

  @@index([superadminId])
  @@index([organizationId])
}
